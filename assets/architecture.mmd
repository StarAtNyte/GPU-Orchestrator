    classDef orch     fill:#2a1f05,stroke:#cc9933,color:#fff3cc
    classDef cloud    fill:#1a0d2a,stroke:#9b59b6,color:#e8ccff

    class PG,RD,ET infra
    class IMGW,CHATW worker
    class DASHBOARDS,IMAGE_UIS,CHAT_UI frontend

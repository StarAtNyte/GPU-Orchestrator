flowchart LR
    subgraph FRONT["Frontend  (Any Server)"]
        direction TB
        DASHBOARDS["Main Dashboard  :8810\nAdmin Dashboard  :8811"]
        IMAGE_UIS["Image UIs\n:8861  :8862  :8865  :8866  :8868"]
        CHAT_UI["AI Chat UI  :8867\nQwen3.5  /  Gemma4\nmodel switcher  +  SSE streaming"]
    end

    subgraph BACK["Backend  (Ubuntu GPU PC  —  RTX 4090)"]
        direction TB

        ORC["Orchestrator  :8890\n──────────────────\nJWT auth  ·  job routing\nworker lifecycle  ·  GPU lock\nidle timeout  ·  stale-job cleanup"]

        subgraph INFRA["Infrastructure"]
            direction LR
            PG[("PostgreSQL\njob history\nuser accounts")]
            RD[("Redis  :16379\njob queues\nchat streams")]
            ET[("etcd\nworker registry\nTTL heartbeats")]
        end

        subgraph GPU["Local GPU Workers  —  exclusive mode"]
            direction LR
            IMGW["Image Workers\nSDXL · Z-Image · Qwen Edit\nQwen Variations · OmniLottie\n12–16 GB  ·  30–90 s startup"]
            CHATW["Chat Workers\nQwen3.5-35B  ·  Gemma4-26B\n18–22 GB  ·  ~600 s startup\nllama.cpp  CUDA  sm_89"]
        end
    end

    subgraph CLOUD["Cloud  (Modal.run)"]
        CW["Panorama Processor\n360 outpaint + rug removal"]
    end

    %% Frontend → Orchestrator
    FRONT -- "POST /submit\nBearer JWT" --> ORC
    CHAT_UI -- "GET /stream/job_id\nSSE" --> ORC

    %% Orchestrator ↔ Infrastructure
    ORC -- "write job\nread result" --> PG
    ORC -- "XADD jobs:app-id\n(dispatch)" --> RD
    ORC -- "check registry" --> ET

    %% Orchestrator → Workers (lifecycle)
    ORC -- "docker start / stop\nVRAM check · idle timeout" --> GPU

    %% Workers ↔ Infrastructure
    GPU -- "XREAD jobs:app-id\n(pull work)" --> RD
    GPU -- "PUT /id  TTL=10s\nheartbeat" --> ET
    GPU -- "UPDATE status\nwrite result" --> PG
    CHATW -- "XADD chat-stream:job_id\n(token streaming)" --> RD

    %% Cloud
    ORC -- "HTTPS forward" --> CW

